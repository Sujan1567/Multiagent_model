# Copy this file to .env and fill in your own value.
# NEVER commit .env to git. That is what .gitignore is for.

# Required. Used by every agent: the triage agent, the three specialists,
# and the guardrail's topic checker.
# Get one at: platform.openai.com > Dashboard > API keys > Create new secret key
OPENAI_API_KEY=sk-put-your-key-here
